# Chunk 7: data_exercise_2
n = 150 # Number of observations
set.seed(43) # random number generator, useful for creating simulations or
#random objects that can be reproduced.
X1 <- runif(n,-1,1) # generates n uniform random numbers between 0 and 1
set.seed(126)
X2 <- runif(n,-1,1)
Y <- rep(0,n)
ind<-which((X1<=-0.15)|(X1>-0.15 & X2<=0.25))
set.seed(54)
Y[ind] <- rbinom(n=length(ind),size=1,p=0.9) # generates n bernouilli
# distributed random variables  with p=0.9
set.seed(52432)
Y[setdiff(1:n,ind)]<- rbinom(n-length(ind),1,0.1)
data_class1 <- data.frame(X1=X1,X2=X2,Y=Y)
