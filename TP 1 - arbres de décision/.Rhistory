library(ggplot2) # To create plots
library(rpart) # To build CART trees
library(rpart.plot) # To plot CART trees
n = 150
set.seed(43)
X1 <- runif(n,0,1)
set.seed(126)
Y <- (X1>0.8)*0.8*X1+(X1<0.8)*(X1>0.35)*(-0.5*X1-1)+(X1<0.35)*(X1-0.5)+rnorm(n,sd=0.2)
data_reg <- data.frame(X1=X1,Y=Y)
plot1<-ggplot(data_reg,aes(x=X1,y=Y))+geom_point(size=2, color="gray")+theme_classic()
plot1
summary(data_reg)
